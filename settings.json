{
  "template": "templates/electrician",
  "template_name": "Electrician · English template",
  "template_edit_policy": "business-details-and-theme-only",
  "dashboard_port": 4310,
  "batch_size": 5,
  "requested_workers": 3,
  "sender_file": "sender.local.json",
  "vercel_cli": [
    "pnpm",
    "dlx",
    "vercel@59.16.0"
  ],
  "firecrawl_env_file": ".env",
  "max_scrape_pages_per_business": 5,
  "max_discovery_candidates": 20,
  "outreach": {
    "auto_submit": false,
    "include_preview_link": true,
    "language": "en",
    "allow_inspection_forms": false,
    "skip_captchas": true,
    "message_mode": "template"
  },
  "worker_model": "sonnet",
  "browser": "chrome-devtools-mcp",
  "build_mode": "quick-template",
  "default_template": "electrician",
  "templates": {
    "electrician": {
      "name": "Electrician · base design",
      "path": "templates/electrician"
    }
  },
  "personalization_fields": [
    "name",
    "phone",
    "email",
    "street",
    "city",
    "zip",
    "theme_color"
  ],
  "scouting": {
    "discovery_start_page": 10,
    "screening_mode": "firecrawl-first",
    "initial_pages_per_business": 2,
    "max_concurrent_business_scrapes": 2,
    "visual_assessment": "agent-views-saved-screenshot",
    "final_form_check": "live-browser"
  }
}
