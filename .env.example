# Copy to .env and fill in. settings.json points firecrawl_env_file at .env.

# Firecrawl API key for homepage/contact-page screening (tools/site_assets.py). Optional: without it,
# screening falls back to the browser.
FIRECRAWL_API_KEY=

# Google Cloud API key for discovery and scoring. Enable "Places API (New)" and "PageSpeed Insights API"
# on the project, and restrict the key to those two APIs. Places Text Search is billed per request (each
# returns up to 20 businesses) after Google's monthly free usage; PageSpeed Insights is free. Used by
# tools/places.py (required) and tools/pagespeed.py (optional; raises its quota).
GOOGLE_MAPS_API_KEY=

# Optional: path to the SQLite ledger (tools/control.py). Defaults to data/revamp.sqlite3; leave commented unless overriding (an empty value breaks the default).
# REVAMP_DB=

# Optional: Chrome/Chromium binary for the template prerender script. Defaults to the macOS Google Chrome path.
CHROME_PATH=

# Optional: port for the copied prerender script's static server (tools/site_assets.py clone); empty picks a free port.
PRERENDER_PORT=
